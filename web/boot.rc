#!/bin/rc
# The website's live demo (scripts/web.sh): what the page asks h9 to run,
# as `rc /9ux/web/boot.rc`. The archive holds 9front's 386 programs and
# the 9/UX tree at /9ux, read-only under an overlay in memory, so
# anything written lasts until the tab closes.
#
# Sets up the session the way a 9/UX profile would: the environment,
# uxd on /mnt/ux and uxmeta on /mnt/meta (with the home volume), before
# rio, so every window has them. Then it runs the rio fork in 9/UX mode
# with session.rc as its -i command. Lines on the console that start
# "9ux: " are progress the page shows over the screen.
#
# scripts/run.sh runs the same session on the host, in an h9 window,
# with the checkout bound at /9ux and the host's architecture: the
# page's machine is 386 and has no $objtype, so that's the default, and
# $O, the compiler letter in the binaries' names, follows $objtype.
#
#	rc boot.rc [-d] [-s] [-v name]
#
# -d (the page's ?debug) has session.rc print what it started; -s (a
# small screen, such as a phone's) has it leave the home folder closed,
# since its window would cover the desktop.
#
# -v name adds a volume for the folder $home/name, which the page fills
# while this runs (site/progrium.html puts a GitHub repository's files
# at /9ux/web/home/name), and session.rc opens it in place of home. The
# page writes /9ux/web/fetched, a line of status, when it's done.
flags=()
vol=()
while(~ $1 -d -s -v){
	if(~ $1 -v){
		vol=$2
		shift
	}
	if not
		flags=($flags $1)
	shift
}
if(~ $#vol 1)
	flags=($flags -v $vol)
# The machine's own user: the plumber names its /srv file after $user and
# refuses an attach from anyone else, so on the host (where h9's user is
# yours) a made-up one leaves `plumber` waiting on its own mount.
if(~ $#user 0)
	user=glenda
home=/usr/glenda
workspace=demo
if(~ $#objtype 0){
	cputype=386
	objtype=386
}
switch($objtype){
case 386
	O=8
case amd64
	O=6
case arm64
	O=7
case *
	echo boot.rc: no binaries for $objtype >[1=2]
	exit objtype
}
prompt=('% ' '	')
path=(. /bin)
font=/lib/font/bit/vga/unicode.font
fn say { echo 9ux: $* >/dev/cons }

say starting the services
# The demo's home, with some files for Desktop to show.
bind -c /9ux/web/home $home
cd $home
t=/tmp/9ux
mkdir -p $t/sys $t/apps $t/user $t/lib
# The services' mount points: the page's archive has them (web/root.list),
# but a 9front root from the release doesn't.
for(m in plumb ux meta res clip)
	test -d /mnt/$m || mkdir -p /mnt/$m

/9ux/uxd/$O.out -m /mnt/ux -g $t/grants

{
	for(e in .txt .md .jsx .js .ts .css .html .svg .json .xml .go .c .h .rc .sh .yml .yaml .toml)
		echo 'ext='$e' type=text'
	echo 'type=text open=edit icon=doc-text desc="Plain text"'
} >$t/sys/base.ndb
# Two volumes on the desktop: the home folder, and Applications, whose
# programs (web/apps) Desktop launches on a double-click.
echo 'volume=home path='$home' icon=disk desktop=yes
volume=Applications path=/9ux/web/apps icon=disk desktop=yes' >$t/user/meta.ndb
# -v: a third volume, once the page has filled its folder.
if(~ $#vol 1){
	say fetching $vol
	while(! test -e /9ux/web/fetched)
		sleep 0.1
	say $vol^: `{cat /9ux/web/fetched}
	mkdir -p $home/$vol
	echo 'volume='$vol' path='$home/$vol' icon=disk-remote desktop=yes' >>$t/user/meta.ndb
}
/9ux/uxmeta/$O.out -s uxmeta.$user -m /mnt/meta -d $t/sys -a $t/apps -u $t/user -w $workspace -i 500

for(f in /mnt/ux/register /mnt/meta/ctl)
	if(! test -e $f)
		echo boot.rc: no $f >[1=2]

say starting rio
exec /9ux/rio/$O.out -u -i 'rc /9ux/web/session.rc '$"flags
