#!/bin/rc
# rio's -i command for the demo (boot.rc). Starts the plumber here, so
# what it starts has rio's $wsys, then Finder, which takes the desktop,
# opens the home volume, and starts the libux sample app, each in a window in this namespace (window
# -m), which has the plumber's /mnt/plumb.
rfork e
debug=$1
fn say { echo 9ux: $* >/dev/cons; if(~ $debug -d) date -n >/dev/cons }
t=/tmp/9ux

# Text files open in acme, which the plumber starts if it isn't running.
echo 'type is text
data matches ''.*\.txt''
plumb to edit
plumb client window -m -r 260 120 900 560 acme -c 1' >$t/lib/plumbing
plumber -p $t/lib/plumbing

say starting Finder
window -m -r 40 60 560 400 rc /9ux/web/finder.rc
# Finder first: the sample's window opens once Finder has the desktop.
for(i in `{seq 1 300})
	if(! ls -p /mnt/ux/apps | grep -s '^finder-')
		sleep 0.1
# Open the home volume, as a double-click on it would.
f=/mnt/ux/apps/`{ls -p /mnt/ux/apps | grep '^finder-' | sed 1q}
d=$f/windows/1/controls/icons
for(i in `{seq 1 100})
	if(! grep -s 'label=home ' $d/items)
		sleep 0.1
echo open `{sed -n 's/^item ([^ ]+) label=home .*/\1/p' $d/items} >$d/ctl
for(i in `{seq 1 100})
	if(! test -e $f/windows/2)
		sleep 0.1

say starting the sample app
# Its window goes at the bottom right of the screen, whose size boot.rc
# has in $uxscreen (the page's canvas), unless that's smaller than it.
x=40 y=200
if(~ $#uxscreen 2){
	x=`{echo $uxscreen(1) - 540 | hoc}
	y=`{echo $uxscreen(2) - 440 | hoc}
	if(test $x -lt 40) x=40
	if(test $y -lt 60) y=60
}
window -m -r $x $y `{echo $x + 520 | hoc} `{echo $y + 420 | hoc} rc /9ux/web/sample.rc
for(i in `{seq 1 300})
	if(! ls -p /mnt/ux/apps | grep -s '^sample-')
		sleep 0.1
say ready

# -d: what's running, a few seconds after ready, and then when acme
# starts (test/web/demo.mjs waits for these).
if(~ $debug -d){
	sleep 5
	date -n
	ps
	ls -l /srv /mnt/ux/apps
	cat /mnt/meta/layers /tmp/9ux/*.err
	while(! ps | grep -s ' acme$')
		sleep 0.5
	echo debug: acme
} >/dev/cons >[2=1]
