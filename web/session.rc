#!/bin/rc
# rio's -i command for the demo (boot.rc). Starts the plumber here, so
# what it starts has rio's $wsys, then Finder, which takes the desktop,
# in a window in this namespace (window -m), which has the plumber's
# /mnt/plumb, and opens the home volume. The sample app isn't started:
# it's in the Applications volume, for a double-click.
rfork e
debug=$1
fn say { echo 9ux: $* >/dev/cons; if(~ $debug -d) date -n >/dev/cons }
t=/tmp/9ux

# Text files open in acme, which the plumber starts if it isn't running.
echo 'type is text
data matches ''.*\.txt''
plumb to edit
plumb client window -m -r 260 120 900 560 acme -c 1' >$t/lib/plumbing
plumber -p $t/lib/plumbing

say starting Finder
window -m -r 40 60 560 400 rc /9ux/web/finder.rc
for(i in `{seq 1 300})
	if(! ls -p /mnt/ux/apps | grep -s '^finder-')
		sleep 0.1
# Open the home volume, as a double-click on it would.
f=/mnt/ux/apps/`{ls -p /mnt/ux/apps | grep '^finder-' | sed 1q}
d=$f/windows/1/controls/icons
for(i in `{seq 1 100})
	if(! grep -s 'label=home ' $d/items)
		sleep 0.1
echo open `{sed -n 's/^item ([^ ]+) label=home .*/\1/p' $d/items} >$d/ctl
for(i in `{seq 1 100})
	if(! test -e $f/windows/2)
		sleep 0.1

say ready

# -d: what's running, a few seconds after ready; then when acme starts
# (test/web/demo.mjs double-clicks README.txt); then a double-click on
# Sample in the Applications volume, through Finder's files, and when
# the sample app has registered.
if(~ $debug -d){
	sleep 5
	date -n
	ps
	ls -l /srv /mnt/ux/apps
	cat /mnt/meta/layers /tmp/9ux/*.err
	while(! ps | grep -s ' acme$')
		sleep 0.5
	echo debug: acme
	echo open `{sed -n 's/^item ([^ ]+) label=Applications .*/\1/p' $d/items} >$d/ctl
	w=()
	for(i in `{seq 1 100})
		if(~ $#w 0){
			w=`{grep -l '^Applications$' $f/windows/*/title >[2]/dev/null | sed 1q}
			sleep 0.1
		}
	a=`{basename -d $w}^/controls/icons
	for(i in `{seq 1 100})
		if(! grep -s 'label=Sample ' $a/items)
			sleep 0.1
	echo open `{sed -n 's/^item ([^ ]+) label=Sample .*/\1/p' $a/items} >$a/ctl
	while(! ls -p /mnt/ux/apps | grep -s '^sample-')
		sleep 0.5
	echo debug: sample
} >/dev/cons >[2=1]
