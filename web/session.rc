#!/bin/rc
# rio's -i command for the demo (boot.rc). Starts the plumber here, so
# what it starts has rio's $wsys, then Desktop, which takes the desktop,
# in a window in this namespace (window -m), which has the plumber's
# /mnt/plumb, and opens the home volume. The sample app isn't started:
# it's in the Applications volume, for a double-click.
rfork e
# boot.rc's flags: -d prints what's running, -s leaves the home folder
# closed on a small screen.
debug=()
small=()
vol=home
while(! ~ $#* 0){
	switch($1){
	case -d
		debug=-d
	case -s
		small=-s
	case -v
		vol=$2
		shift
	}
	shift
}
fn say { echo 9ux: $* >/dev/cons; if(~ $debug -d) date -n >/dev/cons }
t=/tmp/9ux

# Text files open in acme, which the plumber starts if it isn't running:
# the suffixes boot.rc gives the text type.
echo 'type is text
data matches ''.*\.(txt|md|jsx|js|ts|css|html|svg|json|xml|go|c|h|rc|sh|yml|yaml|toml)''
plumb to edit
plumb client window -m -r 260 120 900 560 acme -c 1' >$t/lib/plumbing
plumber -p $t/lib/plumbing

say starting Desktop
window -m -r 40 60 560 400 rc /9ux/web/desktop.rc
for(i in `{seq 1 300})
	if(! ls -p /mnt/ux/apps | grep -s '^desktop-')
		sleep 0.1
# Open the home volume (or boot.rc's -v volume), as a double-click on it
# would, unless the screen is small.
f=/mnt/ux/apps/`{ls -p /mnt/ux/apps | grep '^desktop-' | sed 1q}
d=$f/windows/1/controls/icons
for(i in `{seq 1 100})
	if(! grep -s 'label='$vol' ' $d/items)
		sleep 0.1
if(~ $#small 0){
	echo open `{sed -n 's/^item ([^ ]+) label='$vol' .*/\1/p' $d/items} >$d/ctl
	for(i in `{seq 1 100})
		if(! test -e $f/windows/2)
			sleep 0.1
}

say ready

# -d: what's running, a few seconds after ready; then when acme starts
# (test/web/demo.mjs double-clicks README.txt); then a double-click on
# Sample in the Applications volume, through Desktop's files, and when
# the sample app has registered.
if(~ $debug -d){
	sleep 5
	date -n
	ps
	ls -l /srv /mnt/ux/apps
	cat /mnt/meta/layers /tmp/9ux/*.err
	# boot.rc's -v volume (test/web/progrium.mjs): the window open on it,
	# and what's in it.
	if(! ~ $vol home){
		echo debug: volume $vol
		for(w in $f/windows/*/title){
			cat $w
			echo
		}
		ls -p $home/$vol
		echo debug: volume listed
	}
	while(! ps | grep -s ' acme$')
		sleep 0.5
	echo debug: acme
	echo open `{sed -n 's/^item ([^ ]+) label=Applications .*/\1/p' $d/items} >$d/ctl
	w=()
	for(i in `{seq 1 100})
		if(~ $#w 0){
			w=`{grep -l '^Applications$' $f/windows/*/title >[2]/dev/null | sed 1q}
			sleep 0.1
		}
	a=`{basename -d $w}^/controls/icons
	for(i in `{seq 1 100})
		if(! grep -s 'label=Sample ' $a/items)
			sleep 0.1
	echo open `{sed -n 's/^item ([^ ]+) label=Sample .*/\1/p' $a/items} >$a/ctl
	while(! ls -p /mnt/ux/apps | grep -s '^sample-')
		sleep 0.5
	echo debug: sample
} >/dev/cons >[2=1]
