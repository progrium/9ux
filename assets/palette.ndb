# The 9/UX palette, in ndb(6) form.
#
# Sixteen named colours. Every 9/UX drawing (chrome, controls, icons,
# patterns) uses only these, so the whole look fits a 4-bit table and
# reads well in 1 bit.
#
#   color   name used in code (UXink, ...) and in the style guide
#   char    its letter in .icon, .cursor and pattern sources ('.' is clear)
#   rgb     24-bit value
#   bit     how it renders at 1 bit: 0 black, 1 white, 50 a checkerboard
#   from    where the colour comes from, when it is one of rio's
#
# The cream, butter, sea and teal values are rio's and acme's own
# colours, so 9/UX and legacy rio windows sit together naturally.

color=ink     char=K rgb=000000 bit=0
color=paper   char=W rgb=FFFFFF bit=1
color=cream   char=Y rgb=FFFFEA bit=1  from=acme-text-background
color=butter  char=y rgb=EEEE9E bit=1  from=rio-darkyellow-selection
color=olive   char=o rgb=99994C bit=0  from=rio-yellowgreen
color=mist    char=c rgb=EAFFFF bit=1  from=acme-tag-background
color=sea     char=C rgb=9EEEEE bit=1  from=rio-palegreygreen
color=teal    char=T rgb=55AAAA bit=0  from=rio-greygreen
color=deep    char=D rgb=226666 bit=0
color=navy    char=B rgb=000099 bit=0  from=rio-medblue
color=red     char=R rgb=CC3333 bit=0
color=grey1   char=1 rgb=EEEEEE bit=1
color=grey2   char=2 rgb=CCCCCC bit=1
color=grey3   char=3 rgb=AAAAAA bit=1
color=grey4   char=4 rgb=777777 bit=50 from=rio-background
color=grey5   char=5 rgb=444444 bit=0

# Roles: what each part of the chrome is drawn in. gen/uxstyle.h has
# these as UXcoltitlebar and so on, so rio and libux name the role, not
# the colour. Each role has two values: color, the palette colour it is
# in the light theme (the default), and dark, its 24-bit value in the
# dark theme. rio and libux switch between the two at run time (see
# README.md, Themes); a theme change is a change here.

role=desktop       color=teal    dark=234747  # with sea dots: the Nine teal pattern
role=window        color=paper   dark=292929  # window content, menus, the menu bar, label plates
role=control       color=paper   dark=292929  # button and check box faces, scroll thumbs
role=text          color=ink     dark=E4E4DA  # text, carets, check marks
role=secondary     color=grey5   dark=ABABAB  # secondary text, list headers
role=muted         color=grey4   dark=8E8E8E  # thumb grips, marks
role=line          color=ink     dark=45453F  # outlines and frames
role=shadow        color=ink     dark=000000  # window and menu shadows
role=titlebar      color=butter  dark=9A9A60
role=titlelight    color=cream   dark=B0B07E  # 1 px line along the bar's top
role=titlerule     color=olive   dark=6A6A3C
role=titletext     color=ink     dark=16160C
role=titleoff      color=grey1   dark=353535  # inactive title bar
role=titletextoff  color=grey4   dark=8E8E8E
role=boxfill       color=paper   dark=B4B488  # close and zoom boxes
role=select        color=navy    dark=3249B8  # selected objects
role=selecttext    color=paper   dark=FFFFFF
role=textselect    color=butter  dark=58582F  # selected text
role=field         color=cream   dark=212119
role=focus         color=teal    dark=4A9C9C
role=face          color=grey1   dark=353535  # dialog and settings body
role=dialogband    color=teal    dark=4A9C9C
role=disabled      color=grey3   dark=626262
role=track         color=grey2   dark=434343

# Desktop patterns in the dark theme: each pattern letter whose colour
# has a value here is drawn in that value (gen/patterns/NAME.dark.img).

pattern=dark teal=234747 sea=356666 deep=163030 grey4=2E2E2E grey3=3A3A3A
