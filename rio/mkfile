TARG=rio
OFILES=\
	rio.$O\
	data.$O\
	fsys.$O\
	scrl.$O\
	time.$O\
	util.$O\
	wctl.$O\
	wind.$O\
	ux.$O\
	uxbar.$O\
	uxdrag.$O\
	uxfs.$O\
	uxmenu.$O\
	uxstyle.$O\
	uxglyphs.$O\
	xfid.$O\

HFILES=dat.h\
	fns.h\
	ux.h\
	../assets/gen/uxstyle.h\

</sys/src/cmd/mkone

$O.out:	/$objtype/lib/libdraw.a /$objtype/lib/libframe.a \
	/$objtype/lib/libthread.a /$objtype/lib/libplumb.a /$objtype/lib/libc.a
syms:V:
	$CC -a $CFLAGS rio.c	> syms
	$CC -aa $CFLAGS *.c 	>>syms

# 9/UX assets (assets/gen, made by S8's tools): glyphs and the bar's mark
uxglyphs.$O:	../assets/gen/uxglyphs.c
	$CC $CFLAGS -o $target ../assets/gen/uxglyphs.c

uxstyle.$O:	uxmark.h

uxmark.h:	../assets/gen/icons/mark.16.img
	{
		echo '/* made by mkfile from '$prereq'; do not edit */'
		echo 'static uchar markimg[] = {'
		xd -1x $prereq | awk 'NF > 1 { for(i = 2; i <= NF; i++) printf "0x%s,", $i; printf "\n" }'
		echo '};'
	} >$target

CLEANFILES=uxmark.h
