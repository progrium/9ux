#!/bin/rc
# libux's API on the uitree tree (docs/protocols/ux.md), through the
# sample app: every control the API makes is a node under win/NAME/.
# Run from libux: rc test/sample.rc
rfork ne
suite=sample
. test/lib.rc
startsample
m=$app/win/main

test=root
sed 1q $app/version >$out/v
same $out/v 'uitree 1.0
'
ls $app >$out/ls
for(f in version ctl events menu win) want '/'^$f^'$' $out/ls
ls $app/win >$out/w
want '/main$' $out/w

test=window
same $m/title 'Sample
'
same $m/type 'div
'
same $m/bounds '0 0 480 400
'
want '^activate activate$' $m/ctl

test=controls
same $m/save/type 'button
'
same $m/save/label 'Save
'
same $m/name/type 'input
'
same $m/name/placeholder 'Name
'
same $m/notes/type 'textarea
'
same $m/agree/type 'checkbox
'
same $m/colors/type 'list
'
same $m/files/type 'scroll
'
same $m/files/icons/type 'icon-view
'
same $m/name-label/text 'Name:
'
same $m/name/bounds '80 16 220 20
'
same $m/name/style 'absolute left=80 top=16 w=220 h=20
'
# a child is placed in its parent
same $m/files/icons/style 'absolute left=1 top=1 w=426 h=400
'
want '^click activate$' $m/save/ctl

test=text-field
echo set name 'value=hello' >$m/ctl
same $m/name/value 'hello
'
echo 'set name ''value=J, llo''' >$m/ctl
same $m/name/value 'J, llo
'
# the selection, in runes (libux/types/input/spec)
echo set name '''selection=1 3''' >$m/ctl
same $m/name/selection '1 3
'
echo set name '''selection=7 7''' >$m/ctl
want 'selection=''7 7''' $m/name/tree
# long values go through the value file
echo -n 'line one
line two' >$m/notes/value
same $m/notes/value 'line one
line two
'

test=secret
want '^input password +secret' $m/password/tree
echo set password 'value=hunter2' >$m/ctl
same $m/password/value 'hunter2
'

test=button-click
{
	{
		echo click >$m/save/ctl
		sleep 0.2
		drain 4 $out/a
		drain 5 $out/b
	} <[4]$m/save/events <[5]$app/events
}
want '^click - save via=ctl win=main seq=[0-9]+$' $out/a
want '^click - save via=ctl win=main seq=[0-9]+$' $out/b
# the handler ran: it read the field and set the status
same $m/status/text 'saved J, llo (1)
'

test=checkbox
echo set agree 'value=on' >$m/ctl
same $m/agree/value 'on
'
echo set save 'disabled=on' >$m/ctl
fails 'disabled' rc -c 'echo click >'$m/save/ctl
echo set save 'disabled=off' >$m/ctl

test=list
cat $m/colors/items >$out/l
want '^1 Red$' $out/l
want '^6 Yellow$' $out/l
echo set colors 'value=2' >$m/ctl
same $m/colors/value '2
'
{
	echo event open 'win=main' 'node=colors' 'item=3' 'via=ctl' >$app/debug/inject
	sleep 0.2
	drain 4 $out/e
} <[4]$m/colors/events
want '^open - colors item=3 via=ctl win=main' $out/e
# libux numbers items from 0
same $m/status/text 'opened item 2
'

test=icon-view
i=$m/files/icons
want '^tmp label=tmp icon=folder pos=140,40$' $i/items
echo rename tmp Temp >$i/ctl
want '^tmp label=Temp icon=folder pos=140,40$' $i/items
same $m/status/text 'renamed tmp to Temp
'
echo move tmp 200,80 >$i/ctl
want '^tmp label=Temp icon=folder pos=200,80$' $i/items
echo select readme >$i/ctl
want '^readme ''label=Read Me'' icon=doc-text pos=48,40 selected$' $i/items
want 'selection=readme' $i/tree
echo open readme >$i/ctl
sleep 0.2
same $m/status/text 'opened readme
'
fails 'not found' rc -c 'echo open nosuch >'$i/ctl

test=scroll
echo set files 'origin=40' >$m/ctl
want 'origin=40' $m/files/tree

test=menus
same $app/menu/bar 'file edit
'
want '^item new label=New key=cmd-n$' $app/menu/file
want '^sep$' $app/menu/file
want '^item undo label=Undo key=cmd-z enabled=off$' $app/menu/edit
{
	echo menu 'item=new' >$app/debug/inject
	sleep 0.2
	drain 4 $out/e
} <[4]$app/events
want '^action new - via=menu seq=[0-9]+$' $out/e
same $m/status/text 'new
'
same $m/name/value ''

test=dialog
echo menu 'item=confirm' >$app/debug/inject
sleep 0.2
d=$app/win/dialog-1
same $d/title 'Confirm
'
same $d/item3/text 'Save the document?
'
echo click >$d/ok/ctl
sleep 0.2
same $m/status/text 'confirmed
'
if(test -e $d){
	echo 'FAIL '^$test^': dialog still there'
	failed=1
}

test=resources
# menus from MENU 128 and 129, IDs from the titles
want '^item about-sample ''label=About Sample…''$' $app/menu/file
want '^item confirm label=Confirm… key=cmd-k$' $app/menu/file
want '^item quit label=Quit key=cmd-q$' $app/menu/file
# the list's strings from STR# 128
want '^6 Yellow$' $m/colors/items
# the mount is in libux's own namespace, not ours
if(test -e /mnt/uxres.app){
	echo 'FAIL '^$test^': resfs mount leaked into the namespace'
	failed=1
}

test=alert
echo menu 'item=about-sample' >$app/debug/inject
sleep 0.2
a=$app/win/dialog-2
same $a/title 'Sample
'
ls $a >$out/a
want '/ok$' $out/a
want '/item3$' $out/a
want '/item4$' $out/a
dontwant '/item2$' $out/a
same $a/item3/text 'Sample, built from resources.
'
want '^Saved [0-9]+ times.$' $a/item4/text
echo close >$a/ctl
sleep 0.2
same $m/status/text 'cancelled
'

test=quit
echo quit >$app/ctl
sleep 0.2
if(test -e /srv/$srvname){
	echo 'FAIL '^$test^': app still serving'
	failed=1
}
done
