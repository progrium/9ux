</$objtype/mkfile
# Run from libux with `mk test`.
test:V: $O.dragapp $O.ctlapp
	@{cd ../../resfs && mk $O.resfs}
	@{cd ../../clipd && mk}
	@{cd ../../apps/sample && mk}
	cd .. && O=$O rc test/run.rc
$O.dragapp: dragapp.$O ../libux.a$O
	$LD $LDFLAGS -o $target dragapp.$O ../libux.a$O
dragapp.$O: dragapp.c ../ux.h
	$CC $CFLAGS -I.. dragapp.c
$O.ctlapp: ctlapp.$O ../libux.a$O
	$LD $LDFLAGS -o $target ctlapp.$O ../libux.a$O
ctlapp.$O: ctlapp.c ../ux.h
	$CC $CFLAGS -I.. ctlapp.c
