#!/bin/rc
# A reader that stops reading stalls nothing: state events coalesce,
# action events queue (core.md, Two kinds of event).
rfork ne
suite=stall
. test/lib.rc
startsample
m=$app/win/main

test=stalled-reader
{
	# fd 4 is never read while 100 clicks and 100 moves happen
	for(i in `{seq 100}){
		echo click >$m/save/ctl
		echo move tmp $i^,40 >$m/files/icons/ctl
	}
	# the UI still answers, and a live reader still gets new events
	sleep 0.3
	same $m/status/text 'saved  (100)
'
	{
		echo click >$m/save/ctl
		sleep 0.2
		drain 5 $out/live
	} <[5]$m/save/events
	drain 4 $out/stalled
} <[4]$app/events
want '^click - save via=ctl win=main seq=[0-9]+$' $out/live
# every click is there; the moves are one, the last
grep -c '^click ' $out/stalled >$out/n
same $out/n '101
'
grep -c '^move ' $out/stalled >$out/n
same $out/n '1
'
want '^move - files/icons item=tmp pos=100,40 ' $out/stalled

test=flush
# a blocked read is interrupted cleanly
{
	drain 4 /dev/null	# resync
	@{ sleep 0.3; echo click >$m/save/ctl } &
	drain 4 $out/f
} <[4]$m/save/events
want '^click - save ' $out/f

echo quit >$app/ctl
done
