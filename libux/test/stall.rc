#!/bin/rc
# A reader that stops reading loses events (lost n=N) and stalls nothing.
rfork ne
suite=stall
. test/lib.rc
startsample
c=$app/windows/1/controls

test=stalled-reader
{
	# fd 4 is never read while 300 changes happen
	{for(i in `{seq 300}) echo 'set v'^$i} >$c/name/ctl
	# the UI still answers, and a live reader still gets new events
	same $c/name/value 'v300
'
	{
		echo 'set after' >$c/name/ctl
		drain 5 $out/live
	} <[5]$c/name/events
	drain 4 $out/stalled
} <[4]$c/name/events
want '^[0-9]+ value ctl=windows/1/controls/name value=after$' $out/live
want '^[0-9]+ lost n=[0-9]+$' $out/stalled
dontwant 'resync' $out/stalled

test=lost-then-continues
{
	{for(i in `{seq 300}) echo 'set w'^$i} >$c/name/ctl
	drain 4 $out/x
	echo 'set final' >$c/name/ctl
	drain 4 $out/y
} <[4]$c/name/events
want '^[0-9]+ lost n=' $out/x
want 'value=final$' $out/y

test=flush
# a blocked read is interrupted cleanly
{
	dd -quiet 1 -bs 8192 -count 1 -if /fd/4 >/dev/null	# resync
	@{ sleep 0.3; echo 'set flushed' >$c/name/ctl } &
	dd -quiet 1 -bs 8192 -count 1 -if /fd/4 >$out/f
} <[4]$c/name/events
want 'value=flushed' $out/f

echo quit >$app/ctl
done
