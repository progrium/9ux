</$objtype/mkfile

# libdcore: Desktop's core as a library, and dcore, its shell front end.
LIB=dcore.$O.a
OFILES=\
	meta.$O\
	caps.$O\
	vol.$O\
	folder.$O\
	ops.$O\
	info.$O\
	launch.$O\
	trash.$O\

HFILES=dcore.h
BIN=/$objtype/bin

# desktop, the app: on libux, with the look from assets/gen/uxstyle.h
UIFILES=\
	main.$O\
	view.$O\
	layout.$O\
	infowin.$O\
	alert.$O\
	trashwin.$O\

LIBUX=../libux/libux.a$O
CFLAGS=$CFLAGS -I../libux -I../assets/gen

all:V: $O.dcore $O.desktop

$LIB: $OFILES
	ar vu $LIB $OFILES

$O.dcore: dcore.$O $LIB
	$LD $LDFLAGS -o $target $prereq

$O.desktop: $UIFILES $LIB $LIBUX
	$LD $LDFLAGS -o $target $prereq

$LIBUX:
	cd ../libux && mk

$UIFILES: desktop.h ../libux/ux.h ../assets/gen/uxstyle.h

%.$O: $HFILES

%.$O: %.c
	$CC $CFLAGS $stem.c

install:V: $O.dcore $O.desktop
	cp $O.dcore $BIN/dcore
	cp $O.desktop $BIN/desktop

test:V: all
	cd test && mk test

clean:V:
	rm -f *.[$OS] [$OS].* *.[$OS].a
	cd test && mk clean

nuke:V: clean
