#!/bin/rc
# Interface tests for the Desktop app: rc test/ui.rc [path/to/desktop]
#
# Desktop runs headless (uxheadless=1) and publishes its uitree tree
# (uxpublic=1); the tests drive it from rc the way a script or uxd
# client would, with a real uxmeta behind it. Its windows are win/main
# (the desktop) and win/KIND-N (folder-1, info-1, dialog-1...); menu
# choices go in through debug/inject:
#
#  - the desktop shows the registry's volumes; opening one opens a
#    folder window with the folder's entries
#  - rename, move, new folder, duplicate, view by list, Get Info
#  - files made or removed behind Desktop's back show up on a rescan
#  - layout (window, view, icon positions) is saved in uxmeta, follows
#    an external edit of the ndb file, and survives a restart
#  - a server that can't rename: an alert that offers copy and delete

rfork ne
O=`{sed -n 's/^O=//p' /$objtype/mkfile}
desktop=$1
if(~ $#desktop 0)
	desktop=../$O.desktop
if(! ~ $desktop /*)
	desktop=`{pwd}^/$desktop
here=`{pwd}
uxmeta=$here/../../uxmeta/$O.out
nowstatfs=$here/$O.nowstatfs
t=/tmp/desktop-ui.$pid
nfail=0
npass=0

if(! test -x $uxmeta){
	echo ui: uxmeta not built, skipping
	exit ''
}

fn pass { npass=`{echo $npass + 1 | hoc} }
fn fail {
	echo FAIL: $test: $* >[1=2]
	nfail=`{echo $nfail + 1 | hoc}
}

# has file pattern...
fn has {
	_f=$1
	shift
	for(_p in $*){
		if(grep -s -- $_p $_f)
			pass
		if not {
			fail $_f lacks $_p
			echo '--- got' >[1=2]; cat $_f >[1=2]
		}
	}
}

# lacks file pattern...
fn lacks {
	_f=$1
	shift
	for(_p in $*){
		if(! grep -s -- $_p $_f)
			pass
		if not {
			fail $_f has $_p
			echo '--- got' >[1=2]; cat $_f >[1=2]
		}
	}
}

# waitfor file pattern: up to 5 s for the file to have a line matching
fn waitfor {
	_ok=no
	for(_i in `{seq 50}) if(~ $_ok no){
		if(grep -s -- $2 $1 >[2]/dev/null)
			_ok=yes
		if not
			sleep 0.1
	}
	if(~ $_ok yes)
		pass
	if not {
		fail $1 never had $2
		echo '--- got' >[1=2]; cat $1 >[1=2] >[2]/dev/null
	}
}

# icons win: a window's icon view
fn icons {
	if(test -d $1/scroll/icons)
		echo $1/scroll/icons
	if not
		echo $1/icons
}

# itemid win label: the icon item ID of the label in a window's icon view
fn itemid {
	grep -e 'label='^$2^'( |$)' -e '''label='^$2^'''' `{icons $1}^/items | awk '{print $1}'
}

# winof kind: the windows of that kind
fn winof {
	ls -d $a/win/$1-* >[2]/dev/null
}

# choose item win: a menu item, chosen in a window
fn choose {
	echo menu 'item='^$1 'win='^`{basename $2} >$a/debug/inject
}

fn startdesktop {
	rm -f /srv/ux.$user.desktop
	uxheadless=1 uxpublic=1 $desktop -m /n/fuimeta -w uiws -i 100 >[2]$t/desktop.err &
	desktoppid=$apid
	for(i in `{seq 50}) if(! test -e /srv/ux.$user.desktop) sleep 0.1
	a=$t/app
	mkdir -p $a
	mount -c /srv/ux.$user.desktop $a
	for(i in `{seq 50}) if(! test -s $a/win/main/icons/items) sleep 0.1
}

fn stopdesktop {
	echo quit > $a/ctl
	for(i in `{seq 50}) if(test -d /proc/$desktoppid) sleep 0.1
	unmount $a >[2]/dev/null
}

rm -rf $t
mkdir -p $t/sys $t/apps $t/user $t/vol/docs /n/fuimeta
echo hello > $t/vol/docs/notes.txt
echo hello > $t/vol/a.txt
echo '#!/bin/rc' > $t/vol/run
chmod +x $t/vol/run
cat > $t/sys/base.ndb <<'EOF'
ext=.txt type=text
type=text open=edit icon=doc-text desc="Plain text"
EOF
cat > $t/user/meta.ndb <<EOF
volume=scratch path=$t/vol icon=disk desktop=yes
volume=hidden path=$t/vol/docs desktop=no
EOF
srvname=fuimeta.$pid
$uxmeta -s $srvname -m /n/fuimeta -d $t/sys -a $t/apps -u $t/user -w uiws -i 50
ws=$t/user/workspace/uiws.ndb

test=desktop
startdesktop
d=$a/win/main
has $d/icons/type '^icon-view$'
has $d/icons/items '^i1 label=scratch icon=disk pos='
lacks $d/icons/items 'label=hidden'
has $a/menu/file '^item newfolder ' '^item info ' '^item rename ' '^item close '
has $a/menu/view '^item byicon ' '^item bylist ' '^item cleanup '

test=open-volume
echo open `{itemid $d scratch} > $d/icons/ctl
for(i in `{seq 50}) if(~ $#f 0) { f=`{winof folder}; sleep 0.1 }
if(~ $#f 0)
	fail no folder window
f=$f(1)
has $f/title '^scratch$'
fi=`{icons $f}
has $fi/items 'label=a.txt icon=doc-text ' 'label=docs icon=folder ' 'label=run icon=app '
has $f/status/text '^3 items$'
waitfor $ws '^folder='^$t^'/vol '
has $ws 'open=yes' 'view=icons'

test=rename
echo rename `{itemid $f a.txt} b.txt > $fi/ctl
sleep 0.3
if(test -e $t/vol/b.txt && ! test -e $t/vol/a.txt)
	pass
if not
	fail a.txt was not renamed to b.txt
has $fi/items 'label=b.txt '

test=move
echo move `{itemid $f b.txt} 250,120 > $fi/ctl
waitfor $ws '^item='^$t^'/vol/b.txt x=250 y=120'

test=rescan
echo new > $t/vol/new.txt
waitfor $fi/items 'label=new.txt '
rm $t/vol/new.txt
for(i in `{seq 50}) if(grep -s 'label=new.txt' $fi/items) sleep 0.1
lacks $fi/items 'label=new.txt'

test=newfolder
choose newfolder $f
sleep 0.3
if(test -d $t/vol/'untitled folder')
	pass
if not
	fail no untitled folder
has $fi/items '''label=untitled folder'' icon=folder .* selected$'
# rename in place: a text field over the label; Enter renames
if(test -d $f/rename){
	pass
	echo projects > $f/rename/value
	echo event submit 'win='^`{basename $f} 'node=rename' 'via=user' >$a/debug/inject
	sleep 0.3
	if(test -d $t/vol/projects)
		pass
	if not
		fail rename in place did not rename
}
if not
	fail no rename field

test=duplicate
echo select `{itemid $f b.txt} > $fi/ctl
choose duplicate $f
sleep 0.3
if(test -e $t/vol/'b copy.txt')
	pass
if not
	fail no b copy.txt
has $fi/items '''label=b copy.txt'''

test=info
echo select `{itemid $f b.txt} > $fi/ctl
choose info $f
for(i in `{seq 50}) if(~ $#g 0) { g=`{winof info}; sleep 0.1 }
if(~ $#g 0)
	fail no info window
g=$g(1)
has $g/title '^b.txt Info$'
has $g/kind/text '^Plain text$'
has $g/size/text '^6 bytes$'
has $g/volume/text '^scratch$'
has $g/opens/text '^edit$'
has $g/mode/text '^-rw'
# renaming from Get Info
echo c.txt > $g/name/value
echo event submit 'win='^`{basename $g} 'node=name' 'via=user' >$a/debug/inject
sleep 0.3
if(test -e $t/vol/c.txt)
	pass
if not
	fail Get Info did not rename
has $g/title '^c.txt Info$'
has $fi/items 'label=c.txt '
echo close > $g/ctl

test=list
choose bylist $f
sleep 0.3
has $f/scroll/list/items '^[0-9]+	c\.txt	(text|file)	' '^[0-9]+	docs	folder	--$'
has $a/menu/view '^item bylist .*check=on'
waitfor $ws 'view=list'
choose byicon $f
sleep 0.3
has $fi/items 'label=c.txt '

test=trash
# Move to Trash puts it in the volume's own Trash; the folder view hides .trash
d=$a/win/main
has $d/icons/items 'label=Trash icon=trash '
echo select `{itemid $f b' 'copy.txt} > $fi/ctl
choose trash $f
sleep 0.5
if(! test -e $t/vol/'b copy.txt' && test -d $t/vol/.trash)
	pass
if not
	fail b copy.txt did not go to the Trash
lacks $fi/items 'label=.trash' '''label=b copy.txt'''
waitfor $d/icons/items 'label=Trash icon=trash-full '
echo open `{itemid $d Trash} > $d/icons/ctl
for(i in `{seq 50}) if(~ $#tw 0) { tw=`{winof trash}; sleep 0.1 }
if(~ $#tw 0)
	fail no Trash window
tw=$tw(1)
twi=`{icons $tw}
has $twi/items '''label=b copy.txt'''
has $tw/status/text '^1 item\. '
# Put Back returns it where it was
echo select `{itemid $tw b' 'copy.txt} > $twi/ctl
choose putback $tw
sleep 0.5
if(test -e $t/vol/'b copy.txt')
	pass
if not
	fail Put Back did not put it back
waitfor $fi/items '''label=b copy.txt'''
waitfor $d/icons/items 'label=Trash icon=trash '
# Empty Trash asks first, then deletes
echo select `{itemid $f b' 'copy.txt} > $fi/ctl
choose trash $f
sleep 0.5
echo menu 'item=emptytrash' >$a/debug/inject
for(i in `{seq 50}) if(~ $#al 0) { al=`{winof dialog}; sleep 0.1 }
if(~ $#al 0)
	fail no Empty Trash alert
al=$al(1)
has $al/other/label '^Empty Trash$'
echo click > $al/other/ctl
waitfor $d/icons/items 'label=Trash icon=trash '
lacks $twi/items 'label='
echo close > $tw/ctl
al=()

test=external-edit
# an icon moved by editing the ndb file moves on screen
sed 's;(item='^$t^'/vol/c\.txt) x=[0-9]+ y=[0-9]+;\1 x=300 y=200;' $ws > $t/ws.new
if(grep -s 'c\.txt x=300 y=200' $t/ws.new)
	cat $t/ws.new > $ws
if not
	fail could not edit $ws
waitfor $fi/items 'label=c.txt icon=doc-text pos=300,200'

test=restart
# window, view and positions come back after a restart
fwin=`{basename $f}
stopdesktop
startdesktop
for(i in `{seq 50}) if(~ $#f2 0) { f2=`{winof folder}; sleep 0.1 }
if(~ $#f2 0)
	fail the folder window did not reopen
f=$f2(1)
has $f/title '^scratch$'
has $f/bounds '^0 0 440 300$'
fi=`{icons $f}
has $fi/items 'label=c.txt icon=doc-text pos=300,200'
# closing it means it stays closed
echo close > $f/ctl
waitfor $ws 'open=no'
stopdesktop

test=copydel
# a server with no wstat: an honest alert, and copy and delete only when asked
mkdir -p $t/nw
$nowstatfs -s desktop-nw.$pid -m $t/nw
echo data > $t/nw/x.txt
echo 'volume=nw path='^$t^'/nw desktop=yes' >> $t/user/meta.ndb
sleep 0.3
startdesktop
d=$a/win/main
waitfor $d/icons/items 'label=nw '
echo open `{itemid $d nw} > $d/icons/ctl
for(i in `{seq 50}) if(~ $#f3 0) { f3=`{for(w in `{winof folder}) if(grep -s '^nw$' $w/title) echo $w}; sleep 0.1 }
f=$f3(1)
fi=`{icons $f}
echo rename `{itemid $f x.txt} y.txt > $fi/ctl
for(i in `{seq 50}) if(~ $#al 0) { al=`{winof dialog}; sleep 0.1 }
if(~ $#al 0)
	fail no alert
al=$al(1)
cat $al/msg*/text > $t/msg
has $t/msg 'can''t be renamed' 'not supported'
has $al/other/label '^Copy and Delete$'
has $fi/items 'label=x.txt '
echo click > $al/other/ctl
sleep 0.5
if(test -e $t/nw/y.txt && ! test -e $t/nw/x.txt)
	pass
if not
	fail copy and delete did not happen
waitfor $fi/items 'label=y.txt '
stopdesktop
unmount $t/nw >[2]/dev/null
rm -f /srv/desktop-nw.$pid

if(test -s $t/desktop.err){
	echo '--- desktop stderr' >[1=2]
	cat $t/desktop.err >[1=2]
}
unmount /n/fuimeta >[2]/dev/null
rm -f /srv/$srvname
rm -rf $t
echo ui: $npass passed, $nfail failed
if(! ~ $nfail 0)
	exit fail
exit ''
