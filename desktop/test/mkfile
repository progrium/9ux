# Desktop core tests: unit tests in C, then rc interface tests through
# dcore. Run from ../ as mk test. remote_test.sh (on the host) adds the
# remote-volume test, which needs two h9 machines.

TARG=unit nowstatfs
LIB=../dcore.$O.a

all:V: $O.unit $O.nowstatfs

$O.unit: unit.$O $LIB
	$LD -o $target $prereq

$O.nowstatfs: nowstatfs.$O
	$LD -o $target $prereq

%.$O: %.c ../dcore.h
	$CC $CFLAGS $stem.c

test:V: all
	./$O.unit
	rc ./run ../$O.dcore
	rc ./ui.rc ../$O.desktop

clean:V:
	rm -f *.[$OS] [$OS].*
