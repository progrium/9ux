#!/bin/rc
# clipd against docs/protocols/clip.md, with a plain file for snarf.
# Run from clipd after mk: rc test/clip.rc
rfork ne
failed=0
if(~ $#O 0)
	O=`{sed -n 's/^O=//p' /$objtype/mkfile}
out=/tmp/clipd.$pid
mkdir -p $out

fn want {
	if(! grep -s -- $1 $2){
		echo 'FAIL '^$test^': wanted /'^$1^'/ in '^$2
		sed 's/^/	/' $2
		failed=1
	}
}
fn same {
	echo -n $2 >$out/same
	if(! cmp -s $1 $out/same){
		echo 'FAIL '^$test^': '^$1^' differs'
		echo '	want:'; sed 's/^/	/' $out/same
		echo '	got:'; sed 's/^/	/' $1
		failed=1
	}
}
fn fails {
	pat=$1
	shift
	if($* >[2]$out/err){
		echo 'FAIL '^$test^': '^$"*^' succeeded' >[1=2]
		failed=1
	}
	if not if(! grep -s -- $pat $out/err){
		echo 'FAIL '^$test^': '^$"*^': wanted error /'^$pat^'/' >[1=2]
		sed 's/^/	/' $out/err >[1=2]
		failed=1
	}
}
fn drain { dd -quiet 1 -bs 8192 -count 1 -if /fd/$1 >$2 }

snarf=$out/snarf
echo -n 'already there' >$snarf
c=$out/clip
mkdir -p $c
./$O.out -n $snarf -s clipd.$pid -m $c

test=version
same $c/version 'clip 1.0
'

test=starts-from-snarf
cat $c/types >$out/t
same $out/t 'gen 1
type text size=13
'
same $c/data/text 'already there'

test=copy-one-type
{
	echo -n 'hello' >$c/data/text
	drain 4 $out/e
} <[4]$c/events
same $c/data/text 'hello'
same $snarf 'hello'
want '^[0-9]+ resync$' $out/e
want '^[0-9]+ change gen=2 types=text via=clip$' $out/e

test=batch
{
	echo begin >[1=3]
	echo -n 'Read Me' >$c/data/text
	echo 'file ''name=Read Me'' size=12' >$c/data/file
	same $c/data/text 'hello'		# nothing changes before commit
	fails busy echo begin >$c/ctl
	echo commit >[1=3]
} >[3]$c/ctl
cat $c/types >$out/t
same $out/t 'gen 3
type text size=7
type file size=28
'
ls $c/data >$out/l
want 'data/file$' $out/l
same $snarf 'Read Me'

test=one-type-replaces-all
echo -n 'just an image' >$c/data/image
cat $c/types >$out/t
same $out/t 'gen 4
type image size=13
'
ls $c/data >$out/l
if(grep -s 'data/text$' $out/l){
	echo FAIL $test: data/text still listed
	failed=1
}
fails 'does not exist' cat $c/data/text
same $snarf 'Read Me'		# no text: snarf is left alone

test=legacy-copy
echo -n 'from acme' >$snarf
cat $c/types >$out/t
same $out/t 'gen 5
type text size=9
'
same $c/data/text 'from acme'

test=legacy-copy-event
{
	echo -n 'typed in sam' >$snarf
	sleep 1.5
	drain 4 $out/e
} <[4]$c/events
want '^[0-9]+ change gen=6 types=text via=snarf$' $out/e

test=abort-and-clear
{
	echo begin >[1=3]
	echo -n 'never' >$c/data/text
	echo abort >[1=3]
} >[3]$c/ctl
same $c/data/text 'typed in sam'
fails 'no batch' echo commit >$c/ctl
echo clear >$c/ctl
cat $c/types >$out/t
same $out/t 'gen 7
'
fails 'bad value' touch $c/data/Bad^Type

unmount $c
rm -f /srv/clipd.$pid
rm -rf $out
if(~ $failed 0){
	echo PASS clip
	exit ''
}
echo FAIL clip
exit fail
