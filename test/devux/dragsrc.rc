#!/bin/rc
# dragsrc.rc NAME TYPES: run in a window by the drag tests. When
# $work/NAME.go appears (the test has pressed a button in this window),
# starts a drag from this window offering TYPES, writes its id to
# $work/NAME.id, and answers every fetch for it with 'lazy NAME TYPE
# ITEM' through drag/data, until $work/NAME.stop appears.
name=$1
types=$2
while(! test -e $work/$name.go)
	sleep 0.05
{
	echo start 'types='^$types 'ops=copy,move' >[1=3] || {
		echo start failed >$work/$name.err
		exit start
	}
	sed -n 's/^drag id=([0-9]+) .*state=over.*/\1/p' /dev/ux/drag/state >$work/$name.id
	id=`{cat $work/$name.id}
	cat /dev/ux/drag/events | awk -v 'id='^$id -v 'name='^$name '
	$2 == "fetch" && $3 == "id=" id {
		type = ""; item = "-"; req = ""
		for(i = 4; i <= NF; i++){
			split($i, kv, "=")
			if(kv[1] == "type") type = kv[2]
			if(kv[1] == "item") item = kv[2]
			if(kv[1] == "req") req = kv[2]
		}
		f = "/dev/ux/drag/data"
		printf "reply %s\nlazy %s %s %s", req, name, type, item > f
		close(f)
	}' >[3=] &
	while(! test -e $work/$name.stop)
		sleep 0.1
} >[3]/dev/ux/drag/ctl
