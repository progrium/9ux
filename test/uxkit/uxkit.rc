#!/bin/rc
# uxkit drawing a uitree client: a client script (demo.rc unless the
# first argument names another in this directory) builds a screen
# through $ui, and uxkit draws it with libux. The tree is also posted at
# /srv/uitree.$user, so a test can mount it. Other arguments go to the
# client. uxd runs on /mnt/ux, as in a session, and uxkit registers the
# tree with it (the app is the client's name: tools.rc is tools-1).
cd /mnt/term/cwd/uxkit
O=`{sed -n 's/^O=//p' /$objtype/mkfile}
client=demo.rc
if(! ~ $#* 0){
	client=$1
	shift
}
mkdir -p /mnt/ux
../uxd/$O.out -m /mnt/ux -g $work/grants
resfs=../resfs/$O.resfs uxsysres=../assets/gen/system.rsrc \
	exec ./$O.out -d -s uitree.$user rc /mnt/term/cwd/test/uxkit/$client $* >[2]$work/uxkit.err
