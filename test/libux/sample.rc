#!/bin/rc
# Run the sample app from the tree, with resfs and the system resources
# from the tree too, publishing its UI tree at /srv/ux.$user.sample.
cd /mnt/term/cwd/apps/sample
O=`{sed -n 's/^O=//p' /$objtype/mkfile}
resfs=../../resfs/$O.resfs uxsysres=../../assets/gen/system.rsrc uxpublic=1 exec ./$O.out
